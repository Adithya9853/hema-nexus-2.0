# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Connection (provided automatically at runtime in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional ESP32 BLE Custom GATT Service/Characteristic Overrides (hex UUIDs)
VITE_HEMA_BLE_SERVICE_UUID=""
VITE_HEMA_BLE_MEASUREMENT_CHAR_UUID=""
VITE_HEMA_BLE_CONTROL_CHAR_UUID=""

# Session Signing Secret for local email/password tokens (min 32 characters; required in production)
AUTH_SESSION_SECRET=""

# Optional Firebase Web & Admin overrides (for Vercel / external deployments targeting your own Firebase project)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_PROJECT_ID=""
